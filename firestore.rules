rules_version = '2';

// Deploying this file replaces the rules currently set in the Firebase
// console. The users/{userId} rule matches the one JARVIS's cloud sync
// already requires (see js/auth.js).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Cloud backup of data that has no place in the users/{userId} document
      // (food log, tasks, goals, Discipline, groceries, form-check history).
      // Written by the page itself, in pieces (js/cloud-backup.js); only the
      // owner can read or write.
      match /appData/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Owner-editable marketing data: settings (budget, caps, watchlist,
      // brand profile), the content idea library and audience notes.
      match /marketing/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /marketingIdeas/{ideaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /marketingFindings/{findingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Written only by the server (Cloud Functions bypass these rules), so
      // usage records, cached results and research history can't be edited
      // from a browser.
      match /marketingUsage/{month} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /marketingCache/{entry} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /marketingSnapshots/{handle} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /marketingState/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Reminders are created and edited only through the server's
      // `reminders` function, which checks them and works out when each is due.
      match /reminders/{reminderId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /reminderSettings/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Phone notifications. None of these are readable or writable from a
      // browser, on purpose (the page uses the server's `notifications`
      // function instead):
      //  - pushSubscriptions holds each phone's push address and keys. Anyone
      //    holding an address can send to that phone, so it never leaves the server.
      //  - reminderEvents is the server's record of each reminder moment that
      //    was due, what happened to it and why (sent, missed, failed).
      //  - reminderState holds server bookkeeping such as the last test time.
      match /pushSubscriptions/{id} {
        allow read, write: if false;
      }
      match /reminderEvents/{eventId} {
        allow read, write: if false;
      }
      match /reminderState/{docId} {
        allow read, write: if false;
      }
    }
  }
}
